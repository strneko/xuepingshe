enum UserRole {
  STUDENT
  TEACHER
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum CourseOfferingStatus {
  OPEN
  CLOSED
}

model CourseOffering {
  id             String              @id @default(cuid())
  courseId       String
  courseName     String
  teacherName    String
  semesterKey    String
  status         CourseOfferingStatus @default(OPEN)
  startAt        DateTime?
  endAt          DateTime?
  forceClosedAt  DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  enrollments    Enrollment[]
  reviewRounds   ReviewRound[]
  inviteCode     CourseInviteCode?

  @@unique([courseId, semesterKey])
  @@index([courseId, status])
  @@index([semesterKey, status])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  offeringId  String
  courseId    String
  courseName  String
  teacherName String?
  term        String?
  classTime   String?
  location    String?
  credits     Decimal?         @db.Decimal(4, 1)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([userId, offeringId])
  @@index([userId, status, createdAt])
  @@index([offeringId, status])
  @@index([courseId, term])
}

model CourseInviteCode {
  id          String         @id @default(cuid())
  code        String         @unique
  courseId    String
  offeringId  String         @unique
  semesterKey String
  isActive    Boolean        @default(true)
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([courseId, isActive])
  @@index([semesterKey, isActive])
}
