enum CourseScoreGranularity {
  SEMESTER
  YEAR
  MONTH
  DAY
}

enum CourseReviewStatus {
  VISIBLE
  HIDDEN
  DELETED
  PENDING
}

model CourseProfile {
  courseId    String   @id
  courseName  String
  teacherName String
  intro       String
  location    String
  schedule    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teacherName])
  @@index([updatedAt])
}

enum CourseAnnouncementStatus {
  PUBLISHED
  OFFLINE
}

model CourseAnnouncement {
  id         String                   @id @default(cuid())
  courseId   String
  authorId   String?
  title      String
  content    String
  status     CourseAnnouncementStatus @default(PUBLISHED)
  publishAt  DateTime                 @default(now())
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([courseId, status, publishAt])
  @@index([authorId, createdAt])
}

model CourseReview {
  id               String   @id @default(cuid())
  courseId         String
  userId           String
  roundId          String?
  nickname         String
  avatarUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  overallScore     Float?
  likesCount       Int      @default(0)
  summary          String
  detailedScoresJson Json?
  status           CourseReviewStatus @default(VISIBLE)

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  round            ReviewRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  likes            CourseReviewLike[]

  @@unique([roundId, userId])
  @@index([courseId, createdAt])
  @@index([courseId, likesCount])
  @@index([userId, createdAt])
}

model ReviewRound {
  id         String   @id @default(cuid())
  offeringId String
  courseId   String
  label      String
  startsAt   DateTime
  endsAt     DateTime
  aggregated Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  reviews    CourseReview[]

  @@unique([offeringId, label])
  @@index([offeringId, startsAt])
}

model CourseReviewLike {
  id         String   @id @default(cuid())
  reviewId   String
  userId     String
  createdAt  DateTime @default(now())

  review     CourseReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId, createdAt])
}

model CourseScoreHistory {
  id          String                @id @default(cuid())
  courseId    String
  granularity CourseScoreGranularity
  cursorKey   String
  timeLabel   String
  sortOrder   Int
  overallScore Float?
  attitude    Float?
  content     Float?
  method      Float?
  effect      Float?
  interaction Float?
  resource    Float?
  improve     Float?

  @@unique([courseId, granularity, cursorKey])
  @@index([courseId, granularity, sortOrder])
}
